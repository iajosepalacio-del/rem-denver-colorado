# Copie este archivo a .env.local. No ponga secretos reales en el repositorio.
# Sin estas variables la aplicación arranca, guarda los datos en la base
# y muestra de forma explícita qué integración sigue pendiente.

# Postgres en producción. Si se omite, el desarrollo usa PGlite en .data/pglite.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=

# Solo desarrollo local sin DATABASE_URL. Nunca en producción.
# SEED_DEMO=1

# Primer administrador. Obligatorio cuando la aplicación está publicada.
# Si está vacío, el alta inicial solo se permite en localhost y sin Postgres.
# ADMIN_BOOTSTRAP_TOKEN=

# Correo. Sin SMTP_HOST y SMTP_FROM los mensajes quedan en el buzón interno.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Google Drive. Use OAuth o cuenta de servicio, no ambos a la vez.
# Alcances: https://www.googleapis.com/auth/drive.file
# y, si usa Sheets, https://www.googleapis.com/auth/spreadsheets
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
# GOOGLE_SHEETS_ID=

# Firma. Los tres primeros activan el envío al proveedor.
# El nombre solo permite que un administrador registre un PDF devuelto por ese proveedor.
# SIGNATURE_PROVIDER_NAME=
# SIGNATURE_API_BASE=
# SIGNATURE_API_KEY=
# SIGNATURE_WEBHOOK_SECRET=
